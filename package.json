{
  "name": "fitnexa-web",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "npm run dev -w @fitnexa/dashboard",
    "build": "npm run build -w @fitnexa/dashboard",
    "start": "npm run start -w @fitnexa/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
