# Backend API base URL (server-side only; the browser always calls /api/* on its own host).
API_URL=http://127.0.0.1:4000
# Show /design-preview in production builds (off by default; always on in `next dev`).
# ENABLE_DESIGN_PREVIEW=true
# Proxies in front of this server that append to X-Forwarded-For (Cloudflare = 1). Visitor IPs for the
# API's per-visitor rate limits are read from that hop. 0 / unset = no proxy (development only).
# TRUSTED_PROXY_HOPS=1
